<?xml version='1.0'?>
<sdf version='1.4'>
  <model name="plant">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="plant">
      <visual name="plant">
        <geometry>
          <mesh>
            <uri>model://plant/plant.obj</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
      </visual>
      <!-- simple shape: the mesh collision (65k triangles) hangs the new Gazebo (gz-sim) physics -->
      <collision name="plant_collision">
        <pose>0 0 0.975 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.5</radius>
            <length>1.95</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>
