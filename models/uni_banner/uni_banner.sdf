<?xml version="1.0"?>
<sdf version="1.6">
  <model name="uni_banner">
    <static>true</static>
    <link name="link">
      <!-- flat banner (3.0 x 1.4 m), logo on the +y side; place it with the include pose -->
      <visual name="banner">
        <geometry>
          <mesh>
            <uri>model://uni_banner/uni_banner.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="banner_collision">
        <pose>0 0 0.7 0 0 0</pose>
        <geometry>
          <box>
            <size>3.0 0.02 1.4</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
