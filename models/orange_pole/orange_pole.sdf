<?xml version='1.0'?>
<sdf version='1.4'>
  <model name="orange_pole">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="orange_pole">
      <pose>0 0 0 0 0 0</pose>
      <visual name="pole">
        <geometry>
          <mesh>
            <uri>model://orange_pole/orange_pole.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Cylinder instead of the mesh: the mesh has no normals, which crashes the gz-sim physics -->
      <collision name="pole_collision">
        <pose>0 0 1.1 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>2.2</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>