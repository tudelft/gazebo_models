<?xml version="1.0"?>
<sdf version="1.6">
  <model name="money_tree">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://money_tree/meshes/money_tree.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- simple shape: a mesh collision crashes the physics of the new Gazebo (gz-sim, dartsim) -->
      <collision name="collision">
        <pose>0 0 0.575 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.4</radius>
            <length>1.15</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
