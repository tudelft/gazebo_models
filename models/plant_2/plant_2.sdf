<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="plant_2">
    
    <static>true</static> 
    
    <link name="link">
      
      <visual name="visual">
        <pose>0 0 0 1.5708  0 0 </pose>
        <geometry>
          <mesh>
            <uri>model://plant_2/meshes/Plant2.obj</uri>
            <scale>1 2 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
      <!-- from the floor to the top of the plant -->
      <pose>0 0 1.040 0 0 0</pose>
      <geometry>
        <cylinder>
          <radius>0.25</radius>
          <length>2.08</length>
        </cylinder>
      </geometry>
    </collision>

    </link>
  </model>
</sdf>